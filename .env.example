# Copy to `.env` at the repo root and fill in. `.env` is gitignored; this file is not, so it
# documents which names exist without ever holding a value.
#
#     Copy-Item .env.example .env
#
# Loaded by `src/utils/config.py` on import, so every entry point sees it: `python -m src.main`,
# `streamlit run app/streamlit_app.py`, `pytest`, `scripts/build_index.py`.
#
# A real environment variable wins over anything here, so `$env:GROQ_API_KEY = "..."` still
# overrides this file for one shell without editing it.

# Groq, free tier. https://console.groq.com/keys
# Only needed for the model half: --no-model, --gate, --engine bm25 and the whole test suite
# run without it.
GROQ_API_KEY=

# Optional. Uncomment to send traces somewhere other than the local `phoenix serve`, which
# config/app_config.yaml already points at (observability.endpoint).
# PHOENIX_COLLECTOR_ENDPOINT=
